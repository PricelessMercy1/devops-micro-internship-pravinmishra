{
  "alwaysThinkingEnabled": true,
  "permissions": {
    "allow": [
      "Bash(cd terraform && terraform init*)",
      "Bash(cd terraform && terraform plan*)",
      "Bash(cd terraform && terraform output*)",
      "Bash(cd terraform && terraform show*)",
      "Bash(cd terraform && terraform fmt*)",
      "Bash(cd terraform && terraform validate*)",
      "Bash(aws s3 ls*)",
      "Bash(aws cloudfront get-distribution*)",
      "Bash(aws sts get-caller-identity)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(aws iam *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\user\\AppData\\Local\\Programs\\Git\\usr\\bin\\bash.exe C:\\Users\\user\\Downloads\\devops-micro-internship-pravinmishra\\.claude\\hooks\\user-prompt-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\user\\AppData\\Local\\Programs\\Git\\usr\\bin\\bash.exe C:\\Users\\user\\Downloads\\devops-micro-internship-pravinmishra\\.claude\\hooks\\pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\user\\AppData\\Local\\Programs\\Git\\usr\\bin\\bash.exe C:\\Users\\user\\Downloads\\devops-micro-internship-pravinmishra\\.claude\\hooks\\post-tool-logger.sh"
          }
        ]
      }
    ]
  }
}