{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(terraform apply *)",
      "Bash(terraform apply)",
      "Bash(terraform destroy *)",
      "Bash(terraform destroy)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/terraform.tfvars)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\user\\AppData\\Local\\Programs\\Git\\usr\\bin\\bash.exe\" \"${CLAUDE_PROJECT_DIR}/AI Assignment/tf-apply-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "terraform",
            "args": ["fmt", "-recursive"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
